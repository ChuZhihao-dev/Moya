            "liquid": "<button id=\"quick-checkout\" class=\"quick-checkout-button\">立即结算</button>\n\n<script>\n  // 定义变量以存储当前的变体 ID\n  let currentVariantId = null;\n\n  // 获取页面上变体选择器（通常是 select[name='id'] 或 input[name='id']）\n  const variantSelector = document.querySelector(\"select[name='id']\") \n      ? document.querySelector(\"select[name='id']\") \n      : document.querySelector(\"input[name='id']\");\n\n  // 检查是否找到变体选择器\n  if (variantSelector) {\n    // 初始设置 currentVariantId 为当前选中的变体 ID\n    currentVariantId = variantSelector.value;\n\n    // 添加监听事件，更新 currentVariantId 当用户切换变体时\n    variantSelector.addEventListener(\"change\", function() {\n      currentVariantId = this.value;\n    });\n  }\n\n  document.getElementById(\"quick-checkout\").addEventListener(\"click\", function() {\n    // 获取页面输入的数量\n    const quantityInput = document.querySelector(\"input[name='quantity']\");\n    const quantity = quantityInput ? quantityInput.value : 1; // 如果未输入数量，默认设置为 1\n\n    // 确保当前变体 ID 存在\n    if (!currentVariantId) {\n      alert(\"请选择一个有效的产品变体\");\n      return;\n    }\n\n    // 构造结算链接，使用一次性结账 URL 参数\n    const checkoutUrl = `/checkout?items[0][id]=${currentVariantId}&items[0][quantity]=${quantity}`;\n\n    // 跳转到结算页面\n    window.location.href = checkoutUrl;\n  });\n</script>\n\n<style>\n  .quick-checkout-button {\n    padding: 10px 20px;\n    background-color: #ff6f61;\n    color: #fff;\n    border: none;\n    border-radius: 5px;\n    cursor: pointer;\n    font-size: 16px;\n  }\n  .quick-checkout-button:hover {\n    background-color: #ff3b30;\n  }\n</style>"
