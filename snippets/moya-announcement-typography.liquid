{% comment %}Component-owned typography tokens and selected font faces.{% endcomment %}
{%- assign modes = 'desktop,mobile' | split: ',' -%}
{%- for mode in modes -%}
  {%- liquid
    assign prefix = mode | append: '_type_'
    assign enabled_key = prefix | append: 'enabled'
    assign theme_font_key = prefix | append: 'theme_font'
    assign font_key = prefix | append: 'font'
    assign weight_key = prefix | append: 'weight'
    assign size_key = prefix | append: 'size'
    assign line_height_key = prefix | append: 'line_height'
    assign letter_spacing_key = prefix | append: 'letter_spacing'
    assign gap_key = prefix | append: 'gap'
    assign opacity_key = prefix | append: 'opacity'
    assign component_font = bar_settings[font_key]
    if bar_settings[theme_font_key]
      assign component_font = settings.text_font
    endif
    assign component_weight = bar_settings[weight_key]
    assign weighted_font = component_font | font_modify: 'weight', component_weight
    assign component_font = weighted_font | default: component_font
  -%}
  {%- if bar_settings[enabled_key] -%}
    <style>
      {{ component_font | font_face: font_display: 'swap' }}
      @media screen and ({% if mode == 'desktop' %}min-width: 700px{% else %}max-width: 699px{% endif %}) {
        #shopify-section-{{ section_id }} .moya-announcement-{{ mode }}-type {
          --moya-announcement-font: {{ component_font.family }}, {{ component_font.fallback_families }};
          --moya-announcement-style: {{ component_font.style }};
          --moya-announcement-size: {{ bar_settings[size_key] }}px;
          --moya-announcement-weight: {{ component_weight }};
          --moya-announcement-line-height: {{ bar_settings[line_height_key] }};
          --moya-announcement-letter-spacing: {{ bar_settings[letter_spacing_key] }}px;
          --moya-announcement-gap: {{ bar_settings[gap_key] }}px;
          --moya-announcement-opacity: {{ bar_settings[opacity_key] | default: 100 | divided_by: 100.0 }};
        }
      }
    </style>
  {%- endif -%}
{%- endfor -%}
