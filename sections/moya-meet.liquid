{% render 'moya-fonts' %}

{% comment %}
  Section contract.
  Scroll-driven product story. Pins a full-viewport panel and switches each complete scene
  with a short timed transition at evenly spaced scroll milestones between merchant scene blocks. Progress moves from 0% to 100% along the
  inline-end edge on desktop and across the bottom on mobile.
  Renders as a plain stacked list of panels until the module enhances it.
  @example
  <!-- Add the "Moya Meet" section from the theme editor. -->
{% endcomment %}

{%- liquid
  assign moya_meet_scene_count = section.blocks.size
  assign moya_meet_eyebrow_alpha = section.settings.eyebrow_background_opacity | divided_by: 100.0
-%}

{%- if moya_meet_scene_count > 0 -%}
<moya-meet-component
  id="Moya-Meet-{{ section.id }}"
  class="moya-meet"
  data-cover-next-science="{% if section.settings.cover_next_science == false %}false{% else %}true{% endif %}"
  data-transition-duration="{% if section.settings.enable_transition %}{{ section.settings.transition_duration }}{% else %}0{% endif %}"
  role="region"
  aria-label="{{ section.blocks.first.settings.heading | strip_html | default: 'Meet MoYa' | escape }}"
  style="
    --moya-meet-transition: {{ section.settings.transition_duration | default: 400 }}ms;
    --moya-meet-scenes: {{ moya_meet_scene_count }};
    --moya-meet-scroll: {{ section.settings.scene_scroll }};
    --moya-meet-heading: {{ section.settings.heading_color }};
    --moya-meet-body: {{ section.settings.body_color | color_modify: 'alpha', 0.8 }};
    --moya-meet-eyebrow-bg: {{ section.settings.eyebrow_background | color_modify: 'alpha', moya_meet_eyebrow_alpha }};
    --moya-meet-eyebrow-color: {{ section.settings.eyebrow_text_color }};
    --moya-meet-progress-track: {{ section.settings.progress_color | color_modify: 'alpha', 0.2 }};
    --moya-meet-progress-fill: {{ section.settings.progress_color }};
    --moya-meet-progress-icon: {{ section.settings.progress_icon_color }};
    --moya-meet-mobile-overlay: url('{{ 'moya-meet-mobile-overlay.svg' | asset_url }}');
  "
>
  <span id="moya-features" aria-hidden="true"></span>
  <div class="moya-meet__sticky" data-moya-ref="sticky">
    <div class="moya-meet__scenes">
      {%- for block in section.blocks -%}
        {%- assign moya_meet_has_eyebrow = false -%}
        {%- if block.settings.eyebrow != blank or block.settings.mobile_eyebrow != blank -%}
          {%- assign moya_meet_has_eyebrow = true -%}
        {%- endif -%}
        <article
          class="moya-meet__scene{% if forloop.first %} is-active{% endif %}"
          data-moya-ref="scenes[]"
          aria-label="{{ forloop.index }} / {{ moya_meet_scene_count }}"
          style="--moya-meet-desktop-position: {{ block.settings.desktop_image_position | default: 50 }}%; --moya-meet-mobile-position: {{ block.settings.mobile_image_position | default: 50 }}%;"
          {{ block.shopify_attributes }}
        >
          {% render 'moya-meet-media',
            desktop_type: block.settings.media_type,
            mobile_type: block.settings.mobile_media_type,
            desktop_image: block.settings.image,
            mobile_image: block.settings.mobile_image,
            desktop_video: block.settings.video,
            mobile_video: block.settings.mobile_video
          %}

          <div class="moya-meet__content">
            <div class="moya-meet__inner">
              {%- if moya_meet_has_eyebrow -%}
                <p class="moya-meet__eyebrow moya-meet__reveal">
                  <span{% if block.settings.mobile_eyebrow != blank %} class="moya-meet__desktop-copy"{% endif %}>{{ block.settings.eyebrow | escape }}</span>
                  {%- if block.settings.mobile_eyebrow != blank -%}<span class="moya-meet__mobile-copy">{{ block.settings.mobile_eyebrow | escape }}</span>{%- endif -%}
                </p>
              {%- endif -%}
              {%- if block.settings.heading != blank or block.settings.mobile_heading != blank -%}
                <h2 class="moya-meet__heading moya-meet__reveal">
                  <span{% if block.settings.mobile_heading != blank %} class="moya-meet__desktop-copy"{% endif %}>{{ block.settings.heading | replace: '<p>', '' | replace: '</p>', '<br>' | remove_last: '<br>' }}</span>
                  {%- if block.settings.mobile_heading != blank -%}<span class="moya-meet__mobile-copy">{{ block.settings.mobile_heading }}</span>{%- endif -%}
                </h2>
              {%- endif -%}
              {%- if block.settings.body != blank or block.settings.mobile_body != blank -%}
                <p class="moya-meet__body moya-meet__reveal">
                  <span{% if block.settings.mobile_body != blank %} class="moya-meet__desktop-copy"{% endif %}>{{ block.settings.body | escape }}</span>
                  {%- if block.settings.mobile_body != blank -%}<span class="moya-meet__mobile-copy">{{ block.settings.mobile_body | escape }}</span>{%- endif -%}
                </p>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if moya_meet_scene_count > 1 and section.settings.mobile_scroll_hint != blank -%}
      <p class="moya-meet__scroll-hint" aria-hidden="true">{{ section.settings.mobile_scroll_hint | escape }} <span>&gt;</span></p>
    {%- endif -%}

    {%- if section.settings.show_progress and moya_meet_scene_count > 1 -%}
      <div class="moya-meet__progress" data-moya-ref="progress" aria-hidden="true">
        <span class="moya-meet__progress-line">
          <span class="moya-meet__progress-track"></span>
          <span class="moya-meet__progress-fill" data-moya-ref="fill"></span>
        </span>
        <span class="moya-meet__progress-icon" data-moya-ref="icon">
          {%- if section.settings.progress_icon != blank -%}
            {{
              section.settings.progress_icon
              | image_url: width: 80
              | image_tag: loading: 'lazy', widths: '20,40,60,80', sizes: '20px', alt: '', class: 'moya-meet__progress-face'
            }}
          {%- else -%}
            <svg class="moya-meet__progress-face" viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
              <circle cx="10" cy="10" r="9.25" fill="currentColor"/>
              <circle cx="7.1" cy="8.7" r="1.35" fill="#1c1c1c"/>
              <circle cx="12.9" cy="8.7" r="1.35" fill="#1c1c1c"/>
              <path d="M6.6 12.1c1.02 1.3 2.16 1.95 3.4 1.95s2.38-.65 3.4-1.95" stroke="#1c1c1c" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}
  </div>
</moya-meet-component>
{%- endif -%}

<script type="module">
  import '{{ 'moya-meet.js' | asset_url }}';
</script>

{% stylesheet %}
  .moya-meet {
    display: block;
    position: relative;
    background-color: #111111;
    font-family: 'Outfit', var(--heading-font-family, sans-serif);
  }

  .moya-meet__sticky {
    position: relative;
  }

  .moya-meet__scenes {
    display: block;
  }

  .moya-meet__scene {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background-color: #111111;
  }

  .moya-meet__media {
    position: absolute;
    inset: 0;
  }

  .moya-meet__media img,
  .moya-meet__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    display: block;
    object-fit: cover;
    object-position: var(--moya-meet-desktop-position, 50%) center;
    -webkit-user-drag: none;
    user-select: none;
  }

  .moya-meet__mobile-media {
    display: none;
  }

  .moya-meet__video {
    visibility: hidden;
  }

  .moya-meet__video.is-playing {
    visibility: visible;
  }

  .moya-meet__content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-block: clamp(48px, 7vh, 96px);
    padding-inline: var(--moya-page-inset);
  }


  .moya-meet__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    max-width: 520px;
  }


  .moya-meet__eyebrow {
    margin: 0;
    padding: 2px 6px;
    border-radius: 6px;
    background-color: var(--moya-meet-eyebrow-bg, rgba(255, 255, 255, 0.2));
    color: var(--moya-meet-eyebrow-color, #ffffff);
    font-family: inherit;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }

  .moya-meet__heading {
    margin: 0;
    color: var(--moya-meet-heading, #ffffff);
    font-family: inherit;
    font-size: clamp(36px, 4.44vw, 64px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .moya-meet__heading > * {
    margin: 0;
  }

  .moya-meet__eyebrow + .moya-meet__heading {
    margin-top: 6px;
  }

  .moya-meet__body {
    margin: 0;
    max-width: 460px;
    color: var(--moya-meet-body, rgba(255, 255, 255, 0.8));
    font-family: inherit;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .moya-meet__heading + .moya-meet__body {
    margin-top: 20px;
  }

  .moya-meet__progress,
  .moya-meet__mobile-copy,
  .moya-meet__scroll-hint {
    display: none;
  }

  /* Enhanced (JS) pinned narrative */
  /* Keep the final viewport in place while the next science section covers it. */
  [role='main'] > .shopify-section.moya-meet-section--page-underlay {
    position: sticky;
    top: var(--moya-meet-pin-top, 0px);
    z-index: 0;
  }

  [role='main'] > .shopify-section.moya-science-intro-section--page-overlay {
    z-index: 1;
    box-shadow: 0 -16px 40px rgb(0 0 0 / 18%);
  }

  .moya-meet.is-enhanced {
    height: calc(var(--moya-meet-scenes, 1) * var(--moya-meet-scroll, 100) * 1vh);
  }

  .moya-meet.is-enhanced .moya-meet__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .moya-meet.is-enhanced .moya-meet__scene {
    position: absolute;
    inset: 0;
    min-height: 0;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* A milestone triggers a short transition that completes independently of scrolling. */
  .moya-meet.is-enhanced .moya-meet__scene.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .moya-meet.is-enhanced .moya-meet__scene.is-leaving {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .moya-meet.is-enhanced .moya-meet__scene.is-entering {
    z-index: 2;
    animation: moya-meet-scene-in var(--moya-meet-transition) ease both;
  }

  .moya-meet.is-enhanced .moya-meet__scene.is-leaving .moya-meet__content {
    visibility: hidden;
  }

  .moya-meet.is-enhanced .moya-meet__scene.is-entering .moya-meet__content {
    animation: moya-meet-copy-in var(--moya-meet-transition) ease both;
  }

  @keyframes moya-meet-scene-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes moya-meet-copy-in {
    0%, 35% { opacity: 0; }
    100% { opacity: 1; }
  }

  .moya-meet.is-enhanced .moya-meet__progress {
    display: block;
    position: absolute;
    inset-inline-end: calc(var(--moya-page-inset) + 22px);
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 208px;
    z-index: 3;
  }

  /* The line is cut out around the marker, including the logo's transparent eyes. */
  .moya-meet__progress-line {
    position: absolute;
    inset: 0;
    --moya-meet-line-mask: linear-gradient(to bottom,
      #000 calc(var(--moya-meet-marker-offset, 0px) - 3px),
      transparent calc(var(--moya-meet-marker-offset, 0px) - 3px),
      transparent calc(var(--moya-meet-marker-offset, 0px) + var(--moya-meet-marker-size, 20px) + 3px),
      #000 calc(var(--moya-meet-marker-offset, 0px) + var(--moya-meet-marker-size, 20px) + 3px));
    -webkit-mask-image: var(--moya-meet-line-mask);
    mask-image: var(--moya-meet-line-mask);
  }

  .moya-meet__progress-track,
  .moya-meet__progress-fill {
    position: absolute;
    inset-inline: 0;
    border-radius: 10px;
    pointer-events: none;
  }

  .moya-meet__progress-track {
    inset-block: 0;
    background-color: var(--moya-meet-progress-track, rgba(255, 255, 255, 0.2));
  }

  .moya-meet__progress-fill {
    top: 0;
    height: 0;
    background-color: var(--moya-meet-progress-fill, #ffffff);
  }

  .moya-meet__progress-icon {
    position: absolute;
    top: 0;
    inset-inline-start: 50%;
    margin-inline-start: -10px;
    display: block;
    width: 20px;
    height: 20px;
    color: var(--moya-meet-progress-icon, #ffffff);
    transform: translate3d(0, var(--moya-meet-marker-offset, 0px), 0);
    will-change: transform;
  }

  .moya-meet__progress-face {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (max-width: 749px) {
    .moya-meet__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: var(--moya-meet-mobile-overlay);
      background-size: 100% 100%;
      pointer-events: none;
    }

    .moya-meet__desktop-media {
      display: none;
    }

    .moya-meet__mobile-media {
      display: block;
    }

    .moya-meet__media img,
    .moya-meet__media video {
      object-position: var(--moya-meet-mobile-position, 50%) center;
    }

    .moya-meet__content {
      justify-content: center;
      padding: 64px 24px;
    }

    .moya-meet__inner {
      width: 289px;
      max-width: 100%;
      align-items: center;
      text-align: center;
    }

    .moya-meet__desktop-copy {
      display: none;
    }

    .moya-meet__mobile-copy {
      display: inline;
    }

    .moya-meet__eyebrow {
      padding: 2px 4px;
      border-radius: 3.42px;
      font-size: 8px;
      -webkit-backdrop-filter: blur(5.7px);
      backdrop-filter: blur(5.7px);
    }

    .moya-meet__eyebrow + .moya-meet__heading {
      margin-top: 3.42px;
    }

    .moya-meet__heading {
      font-size: 36px;
      line-height: 1.1;
    }

    .moya-meet__body {
      max-width: 172.146px;
      font-size: 10px;
    }

    .moya-meet__heading + .moya-meet__body {
      margin-top: 11.4px;
    }

    .moya-meet.is-enhanced .moya-meet__scroll-hint {
      position: absolute;
      inset-inline: 24px;
      bottom: max(49px, calc(env(safe-area-inset-bottom, 0px) + 29px));
      z-index: 3;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 4px;
      margin: 0;
      color: var(--moya-meet-heading, #ffffff);
      font-size: 8px;
      font-weight: 600;
      line-height: 1.5;
      letter-spacing: -0.02em;
      pointer-events: none;
    }

    .moya-meet.is-enhanced .moya-meet__progress {
      inset-inline: auto;
      left: 50%;
      top: auto;
      bottom: max(27px, calc(env(safe-area-inset-bottom, 0px) + 7px));
      width: 158.5px;
      height: 3px;
      transform: translateX(-50%);
    }

    .moya-meet__progress-line {
      --moya-meet-line-mask: linear-gradient(to right,
        #000 calc(var(--moya-meet-marker-offset, 0px) - 3px),
        transparent calc(var(--moya-meet-marker-offset, 0px) - 3px),
        transparent calc(var(--moya-meet-marker-offset, 0px) + var(--moya-meet-marker-size, 20px) + 3px),
        #000 calc(var(--moya-meet-marker-offset, 0px) + var(--moya-meet-marker-size, 20px) + 3px));
    }

    .moya-meet__progress-icon {
      top: 50%;
      left: 0;
      inset-inline-start: 0;
      margin: -10px 0 0;
      transform: translate3d(var(--moya-meet-marker-offset, 0px), 0, 0);
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Moya Meet",
  "tag": "section",
  "class": "moya-meet-section",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "info": "Rendered at 80% opacity.",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_background",
      "label": "Eyebrow background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "eyebrow_background_opacity",
      "label": "Eyebrow background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "color",
      "id": "eyebrow_text_color",
      "label": "Eyebrow text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Progress indicator"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show progress indicator",
      "default": true
    },
    {
      "type": "color",
      "id": "progress_color",
      "label": "Progress bar color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "progress_icon_color",
      "label": "Icon color",
      "info": "Applies to the built-in icon only.",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "progress_icon",
      "label": "Icon image",
      "info": "Optional. Falls back to the built-in icon when empty."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "cover_next_science",
      "label": "Science covers the final scene",
      "info": "Keeps the final scene pinned while the immediately following Moya Science Experience scrolls up over it.",
      "default": true
    },
    {
      "type": "range",
      "id": "scene_scroll",
      "label": "Scroll distance per scene",
      "info": "Scenes change at evenly spaced milestones. Transition timing is independent of scrolling.",
      "min": 60,
      "max": 200,
      "step": 10,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "text",
      "id": "mobile_scroll_hint",
      "label": "Mobile scroll hint",
      "default": "Swipe to explore More",
      "info": "Scenes continue to change as the page scrolls. Clear to hide."
    },
    {
      "type": "header",
      "content": "Scene transitions"
    },
    {
      "type": "checkbox",
      "id": "enable_transition",
      "label": "Enable scene transition",
      "default": true
    },
    {
      "type": "range",
      "id": "transition_duration",
      "label": "Transition duration",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "ms",
      "default": 400
    }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Scene",
      "settings": [
        {
          "type": "header",
          "content": "Desktop background"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Desktop background type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image / video poster"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Desktop video"
        },
        {
          "type": "range",
          "id": "desktop_image_position",
          "label": "Desktop background horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "header",
          "content": "Mobile background"
        },
        {
          "type": "select",
          "id": "mobile_media_type",
          "label": "Mobile background type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image / video poster",
          "info": "Independent mobile background. Uses the desktop image or video poster when empty."
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video"
        },
        {
          "type": "range",
          "id": "mobile_image_position",
          "label": "Mobile background horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "AT HOME"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading",
          "default": "<p>A quiet presence always within reach</p>"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Moya stays close through slow morning, busy afternoon, and everything in between."
        },
        {
          "type": "header",
          "content": "Mobile text overrides"
        },
        {
          "type": "text",
          "id": "mobile_eyebrow",
          "label": "Mobile eyebrow",
          "info": "Optional. Uses the eyebrow above when empty."
        },
        {
          "type": "inline_richtext",
          "id": "mobile_heading",
          "label": "Mobile heading",
          "info": "Optional. Uses the heading above when empty."
        },
        {
          "type": "textarea",
          "id": "mobile_body",
          "label": "Mobile body",
          "info": "Optional. Uses the body above when empty."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Moya Meet",
      "blocks": [
        {
          "type": "scene",
          "settings": {
            "eyebrow": "AT HOME",
            "heading": "<p>A quiet presence always within reach</p>",
            "body": "Moya stays close through slow morning, busy afternoon, and everything in between."
          }
        },
        {
          "type": "scene",
          "settings": {
