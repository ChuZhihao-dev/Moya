{{ 'moya-specifications.min.css' | asset_url | stylesheet_tag }}
<script src='{{ 'moya-specifications.min.js' | asset_url }}' defer></script>

<moya-specifications
  class='moya-specs'
  data-motion='{{ section.settings.enable_motion }}'
  data-duration='{{ section.settings.duration }}'
  style='--specs-background: {{ section.settings.background }}; --specs-ink: {{ section.settings.text_color }}; --specs-panel: {{ section.settings.panel_background }}; --specs-spacing: {{ section.settings.padding_block }}px; --specs-duration: {{ section.settings.duration }}ms;'
>
  <div class='moya-specs__container'>
    <div class='moya-specs__information'>
      {% if section.settings.heading != blank %}
        <h2 class='moya-specs__heading'>{{ section.settings.heading | escape }}</h2>
      {% endif %}
      <div class='moya-specs__groups'>
        {% for block in section.blocks %}
          {% if block.type == 'group' %}
            {% assign parameter_offset = forloop.index %}
            <details
              class='moya-specs__group'
              data-specs-group
              {% if block.settings.open %}
                open
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <summary
                class='moya-specs__summary'
                aria-controls='Specs-{{ section.id }}-{{ block.id }}'
              >
                <h3>{{ block.settings.title | escape }}</h3>
                <img
                  class='moya-specs__chevron'
                  src='{{ 'moya-specifications-chevron.svg' | asset_url }}'
                  alt=''
                  width='20'
                  height='20'
                  loading='lazy'
                >
              </summary>
              <div
                class='moya-specs__body'
                id='Specs-{{ section.id }}-{{ block.id }}'
                data-specs-body
              >
                <dl class='moya-specs__parameters'>
                  {% for parameter in section.blocks offset: parameter_offset %}
                    {% if parameter.type == 'group' %}{% break %}{% endif %}
                    {% if parameter.type == 'parameter' %}
                      <div
                        class='moya-specs__parameter{% if parameter.settings.full_width %} moya-specs__parameter--wide{% endif %}'
                        {{ parameter.shopify_attributes }}
                      >
                        <dt>{{ parameter.settings.label | escape }}</dt>
                        <dd class='moya-specs__value'>{{ parameter.settings.value }}</dd>
                      </div>
                    {% endif %}
                  {% endfor %}
                </dl>
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <aside
      class='moya-specs__box'
      {% if section.settings.box_heading != blank %}
        aria-labelledby='SpecsBox-{{ section.id }}'
      {% endif %}
    >
      {% if section.settings.box_heading != blank %}
        <h2 class='moya-specs__box-heading' id='SpecsBox-{{ section.id }}'>
          {{ section.settings.box_heading | escape }}
        </h2>
      {% endif %}
      <div class='moya-specs__hero'>
        {% if section.settings.product_image != blank %}
          {{
            section.settings.product_image
            | image_url: width: 1080
            | image_tag:
              widths: '300, 450, 600, 800, 1080',
              sizes: '(min-width: 1000px) 354px, (min-width: 750px) 42vw, 80vw',
              loading: 'lazy',
              class: 'moya-specs__image'
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'moya-specs__placeholder' }}
        {% endif %}
      </div>
      <ul class='moya-specs__items' role='list'>
        {% for block in section.blocks %}
          {% if block.type == 'box_item' %}
            <li class='moya-specs__item' {{ block.shopify_attributes }}>
              <div class='moya-specs__item-media'>
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 480
                    | image_tag:
                      widths: '120, 180, 240, 360, 480',
                      sizes: '(min-width: 1000px) 144px, (min-width: 750px) 15vw, 40vw',
                      loading: 'lazy',
                      class: 'moya-specs__image'
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'moya-specs__placeholder' }}
                {% endif %}
              </div>
              {% if block.settings.title != blank %}
                <p class='moya-specs__item-title'>{{ block.settings.title | escape }}</p>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </aside>
  </div>
</moya-specifications>

