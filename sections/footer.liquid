{% comment %}Moya footer, Figma 20:375. Menus and social URLs remain editable; payment methods come from Shopify.{% endcomment %}
{% render 'moya-fonts' %}
{{ 'moya-footer.css' | asset_url | stylesheet_tag }}
<div class="moya-footer moya-footer--{{ section.settings.layout }}" style="--mf-background: {{ section.settings.background }}; --mf-text: {{ section.settings.text_color.rgb }}; --mf-opacity: {{ section.settings.text_opacity | divided_by: 100.0 }}; --mf-padding: {{ section.settings.padding_vertical }}px; --mf-mobile-side: {{ section.settings.mobile_padding }}px; --mf-size: {{ section.settings.font_size }}px; --mf-mobile-size: {{ section.settings.mobile_font_size }}px; --mf-logo-width: {{ section.settings.logo_width }}px;">
  <div class="moya-footer__outer">
    <div class="moya-footer__inner">
      <div class="moya-footer__main">
        <div class="moya-footer__brand">
          <div>
            <a class="moya-footer__logo" href="{{ routes.root_url }}" aria-label="{{ section.settings.logo_alt | escape }}">
              {% if section.settings.logo != blank %}
                {{ section.settings.logo | image_url: width: 480 | image_tag: widths: '150, 300, 480', sizes: '240px', loading: 'lazy', alt: section.settings.logo_alt }}
              {% else %}
                <img class="moya-footer__default-logo" src="{{ 'moya-footer-logo.svg' | asset_url }}" alt="{{ section.settings.logo_alt | escape }}" width="146" height="32" loading="lazy">
              {% endif %}
            </a>
            {% if section.settings.tagline != blank %}<p class="moya-footer__tagline">{{ section.settings.tagline | escape | newline_to_br }}</p>{% endif %}
          </div>
          {% if section.settings.show_social_media %}
            {% render 'moya-footer-social' %}
          {% endif %}
        </div>
        {% for block in section.blocks %}
          <nav class="moya-footer__menu" aria-labelledby="MoyaFooter-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
            <p id="MoyaFooter-{{ section.id }}-{{ block.id }}" class="moya-footer__title">{{ block.settings.title | default: block.settings.menu.title | escape }}</p>
            <ul class="moya-footer__links" role="list">
              {% if block.settings.menu != blank %}
                {% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}
              {% else %}
                {% for i in (1..5) %}
                  {% liquid
                    assign label_key = 'label_' | append: i
                    assign url_key = 'url_' | append: i
                    assign label = block.settings[label_key]
                    assign link_url = block.settings[url_key]
                  %}
                  {% if label != blank %}
                    <li>{% if link_url != blank %}<a href="{{ link_url }}">{{ label | escape }}</a>{% else %}<span>{{ label | escape }}</span>{% endif %}</li>
                  {% endif %}
                {% endfor %}
              {% endif %}
            </ul>
          </nav>
        {% endfor %}
      </div>
      <div class="moya-footer__bottom">
        <p class="moya-footer__copyright">© Copyright, {{ section.settings.copyright | default: shop.name | escape }}, {{ 'now' | date: '%Y' }}{% if section.settings.show_powered_by %} {{ powered_by_link }}{% endif %}</p>
        {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
          <ul class="moya-footer__payments" role="list" aria-label="Accepted payment methods">
            {% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Moya footer",
  "tag": "footer",
  "class": "shopify-section--moya-footer",
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alternative text",
      "default": "MoYa"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 240,
      "step": 2,
      "unit": "px",
      "default": 150
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand description",
      "default": "A warmer kind of intelligent companionship."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright owner",
      "default": "SoulX"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show Powered by Shopify",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "Show social media",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Social links use the theme social media settings. Unconfigured links are hidden."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show accepted payment methods",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Payment icons reflect the payment methods enabled in your store."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#003521"
    },
    {
      "type": "range",
      "id": "text_opacity",
      "label": "Link and description opacity",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "paragraph",
      "content": "Desktop content width follows Theme settings > Appearance and spacing > Page width."
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Desktop vertical padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile side padding",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile text size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "columns",
          "label": "Four columns"
        },
        {
          "value": "brand_top",
          "label": "Brand above menus"
        }
      ],
      "default": "columns"
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Discover"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Choose a navigation menu, or use the individual links below."
        },
        {
          "type": "paragraph",
          "content": "Individual labels without a URL display as text. Add a URL to make each item a link."
        },
        {
          "type": "text",
          "id": "label_1",
          "label": "Link 1 label"
        },
        {
          "type": "url",
          "id": "url_1",
          "label": "Link 1 URL"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Link 2 label"
        },
        {
          "type": "url",
          "id": "url_2",
          "label": "Link 2 URL"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "Link 3 label"
        },
        {
          "type": "url",
          "id": "url_3",
          "label": "Link 3 URL"
        },
        {
          "type": "text",
          "id": "label_4",
          "label": "Link 4 label"
        },
        {
          "type": "url",
          "id": "url_4",
          "label": "Link 4 URL"
        },
        {
          "type": "text",
          "id": "label_5",
          "label": "Link 5 label"
        },
        {
          "type": "url",
          "id": "url_5",
          "label": "Link 5 URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Moya footer",
      "blocks": [
        {
          "type": "links",
          "settings": {
            "title": "Discover"
          }
        },
        {
          "type": "links",
          "settings": {
            "title": "Help"
          }
        },
        {
          "type": "links",
          "settings": {
            "title": "Policies"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
