{% render 'moya-fonts' %}

{% comment %}
  Section contract.
  Renders a merchant-configurable glass tab slider with image or fallback illustrations.
  @example
  <!-- Add the Moya Tab Slider section from the theme editor. -->
{% endcomment %}

{%- liquid
  assign moya_tab_background_image = blank
  if section.settings.background_image != blank
    assign moya_tab_background_image = section.settings.background_image | image_url: width: 2400
  endif
-%}

<section
  class='moya-tab-slider-section'
  style='
    --moya-tab-background: {{ section.settings.background_color }};
    --moya-tab-heading: {{ section.settings.heading_color }};
    --moya-tab-text: {{ section.settings.text_color }};
    --moya-tab-label: {{ section.settings.tab_color }};
    --moya-tab-background-opacity: {{ section.settings.background_opacity | divided_by: 100.0 }};
    {% if moya_tab_background_image != blank %}--moya-tab-background-image: url('{{ moya_tab_background_image }}');{% endif %}
  '
>
  <moya-tab-slider-component
    class='moya-tab-slider'
    data-autoplay='{{ section.settings.autoplay }}'
    data-autoplay-interval='{{ section.settings.autoplay_interval | times: 1000 }}'
    aria-label='{{ section.settings.accessibility_label | escape }}'
  >
    <div class='moya-tab-slider__background' aria-hidden='true'></div>

    <div class='moya-tab-slider__viewport' data-moya-ref='viewport'>
      <div class='moya-tab-slider__track' dir='ltr' data-moya-ref='track'>
        {%- for block in section.blocks -%}
          {%- assign moya_tab_loading = 'lazy' -%}
          {%- assign moya_tab_alt = block.settings.heading | strip_html -%}
          {%- if forloop.first -%}
            {%- assign moya_tab_loading = 'eager' -%}
          {%- endif -%}
          <article
            class='moya-tab-slider__slide{% if forloop.first %} is-active{% endif %}'
            data-moya-ref='slides[]'
            data-slide-index='{{ forloop.index0 }}'
            id='MoyaTabPanel-{{ section.id }}-{{ block.id }}'
            role='tabpanel'
            dir='{% render 'direction' %}'
            aria-labelledby='MoyaTab-{{ section.id }}-{{ block.id }}'
            aria-hidden='{% if forloop.first %}false{% else %}true{% endif %}'
            {{ block.shopify_attributes }}
          >
            <div class='moya-tab-slider__card'>
              <div class='moya-tab-slider__content'>
                {%- if block.settings.heading != blank -%}
                  <h2 class='moya-tab-slider__heading'>{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class='moya-tab-slider__text'>{{ block.settings.text }}</p>
                {%- endif -%}
              </div>

              <div class='moya-tab-slider__visual' aria-hidden='true'>
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: moya_tab_loading,
                      widths: '480,640,800,1000,1200',
                      sizes: '(min-width: 990px) 44vw, 86vw',
                      alt: moya_tab_alt,
                      class: 'moya-tab-slider__image'
                  }}
                {%- else -%}
                  <div class='moya-tab-slider__diagram'>
                    <span class='moya-tab-slider__line moya-tab-slider__line--one'></span>
                    <span class='moya-tab-slider__line moya-tab-slider__line--two'></span>
                    <span class='moya-tab-slider__line moya-tab-slider__line--three'></span>
                    <span class='moya-tab-slider__line moya-tab-slider__line--four'></span>
                    <span class='moya-tab-slider__line moya-tab-slider__line--five'></span>
                    <span class='moya-tab-slider__dot moya-tab-slider__dot--one'></span>
                    <span class='moya-tab-slider__dot moya-tab-slider__dot--two'></span>
                    <span class='moya-tab-slider__dot moya-tab-slider__dot--three'></span>
                    <span class='moya-tab-slider__bubble moya-tab-slider__bubble--one'>
                      {{- block.settings.bubble_1 | escape -}}
                    </span>
                    <span class='moya-tab-slider__bubble moya-tab-slider__bubble--two'>
                      {{- block.settings.bubble_2 | escape -}}
                    </span>
                    <span class='moya-tab-slider__bubble moya-tab-slider__bubble--three'>
                      {{- block.settings.bubble_3 | escape -}}
                    </span>
                    <span class='moya-tab-slider__bubble moya-tab-slider__bubble--four'>
                      {{- block.settings.bubble_4 | escape -}}
                    </span>
                    <span class='moya-tab-slider__bubble moya-tab-slider__bubble--five'>
                      {{- block.settings.bubble_5 | escape -}}
                    </span>
                    <span class='moya-tab-slider__bubble moya-tab-slider__bubble--six'>
                      {{- block.settings.bubble_6 | escape -}}
                    </span>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class='moya-tab-slider__controls'>
        <div
          class='moya-tab-slider__tabs'
          role='tablist'
          aria-label='{{ section.settings.accessibility_label | escape }}'
        >
          <span
            class='moya-tab-slider__tab-indicator'
            data-moya-ref='tabIndicator'
            aria-hidden='true'
          ></span>
          {%- for block in section.blocks -%}
            <button
              class='moya-tab-slider__tab'
              id='MoyaTab-{{ section.id }}-{{ block.id }}'
              type='button'
              role='tab'
              data-moya-ref='tabs[]'
              data-tab-index='{{ forloop.index0 }}'
              aria-controls='MoyaTabPanel-{{ section.id }}-{{ block.id }}'
              aria-selected='{% if forloop.first %}true{% else %}false{% endif %}'
              tabindex='{% if forloop.first %}0{% else %}-1{% endif %}'
            >
              {{ block.settings.tab_label | escape }}
            </button>
          {%- endfor -%}
        </div>

        <div class='moya-tab-slider__arrows'>
          <button
            class='moya-tab-slider__arrow moya-tab-slider__arrow--previous'
            type='button'
            aria-label='{{ 'general.accessibility.previous' | t }}'
            data-moya-previous
          >
            <span aria-hidden='true'>{% render 'icon', icon: 'chevron-left' %}</span>
          </button>
          <button
            class='moya-tab-slider__arrow moya-tab-slider__arrow--next'
            type='button'
            aria-label='{{ 'general.accessibility.next' | t }}'
            data-moya-next
          >
            <span aria-hidden='true'>{% render 'icon', icon: 'chevron-right' %}</span>
          </button>
        </div>
      </div>
    {%- endif -%}
  </moya-tab-slider-component>
</section>

<script type='module'>
  import '{{ 'moya-tab-slider.js' | asset_url }}';
</script>

{% stylesheet %}
  .moya-tab-slider-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--moya-tab-background, #f0f2f2);
    padding-block: clamp(40px, 5.5vw, 64px) clamp(48px, 7vw, 80px);
  }

  .moya-tab-slider {
    --moya-tab-card-width: min(1022px, calc(100vw - 48px));
    position: relative;
    z-index: 1;
    display: block;
    font-family: 'Outfit', var(--text-font-family, sans-serif);
    width: 100%;
    color: var(--moya-tab-heading, #385950);
  }

  .moya-tab-slider__background {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image: var(--moya-tab-background-image);
    background-position: center;
    background-size: cover;
    opacity: var(--moya-tab-background-opacity, 0.6);
    pointer-events: none;
  }

  .moya-tab-slider__viewport {
    width: 100%;
    overflow: visible;
    touch-action: pan-y;
    user-select: none;
  }

  .moya-tab-slider__track {
    display: flex;
    align-items: stretch;
    gap: 24px;
    width: max-content;
    transform: translateX(0);
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .moya-tab-slider__slide {
    flex: 0 0 var(--moya-tab-card-width);
    width: var(--moya-tab-card-width);
    min-width: 0;
    opacity: 0.2;
    pointer-events: none;
    transition: opacity 420ms ease;
  }

  .moya-tab-slider__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .moya-tab-slider__card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(360px, 1.08fr);
    align-items: center;
    width: 100%;
    min-height: 540px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 38px;
    background:
      radial-gradient(circle at 85% 80%, rgba(174, 218, 207, 0.48), transparent 42%),
      linear-gradient(
        152deg,
        rgba(255, 255, 255, 0.47),
        rgba(218, 239, 233, 0.39) 56%,
        rgba(240, 248, 246, 0.48)
      );
    box-shadow:
      0 14px 42px rgba(61, 85, 62, 0.08),
      inset 0 2px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(116, 150, 111, 0.09);
    backdrop-filter: blur(30px);
  }

  .moya-tab-slider__content {
    position: relative;
    z-index: 1;
    align-self: center;
    min-width: 0;
    width: auto;
    margin-inline-start: clamp(28px, 3.8vw, 39px);
    margin-inline-end: 20px;
  }

  .moya-tab-slider__heading {
    margin: 0 0 18px;
    color: var(--moya-tab-heading, #385950);
    font-family: 'Outfit', var(--heading-font-family, sans-serif);
    font-size: clamp(38px, 3.8vw, 56px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
    text-transform: none;
    overflow-wrap: break-word;
  }

  .moya-tab-slider__text {
    max-width: 336px;
    margin: 0;
    color: var(--moya-tab-text, rgba(74, 85, 101, 0.8));
    font-family: 'Outfit', var(--text-font-family, sans-serif);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .moya-tab-slider__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(461px, calc(100% - 24px));
    height: 432px;
    margin-inline-end: clamp(20px, 3.8vw, 39px);
  }

  .moya-tab-slider__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .moya-tab-slider__diagram {
    position: relative;
    width: 100%;
    height: 100%;
    color: #37584d;
    font-family: 'Outfit', var(--text-font-family, sans-serif);
  }

  .moya-tab-slider__line {
    position: absolute;
    height: 2px;
    transform-origin: left center;
    background: rgba(255, 255, 255, 0.72);
  }

  .moya-tab-slider__line--one {
    top: 28%;
    left: 17%;
    width: 30%;
    transform: rotate(35deg);
  }

  .moya-tab-slider__line--two {
    top: 50%;
    left: 32%;
    width: 30%;
    transform: rotate(-30deg);
  }

  .moya-tab-slider__line--three {
    top: 51%;
    left: 47%;
    width: 24%;
    transform: rotate(-47deg);
  }

  .moya-tab-slider__line--four {
    top: 51%;
    left: 47%;
    width: 25%;
    transform: rotate(33deg);
  }

  .moya-tab-slider__line--five {
    top: 52%;
    left: 47%;
    width: 28%;
    transform: rotate(65deg);
  }

  .moya-tab-slider__dot {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #f1dc00;
  }

  .moya-tab-slider__dot--one {
    top: 49%;
    left: 45%;
  }

  .moya-tab-slider__dot--two {
    top: 62%;
    left: 34%;
  }

  .moya-tab-slider__dot--three {
    top: 67%;
    left: 58%;
  }

  .moya-tab-slider__bubble {
    position: absolute;
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.6);
    color: #37584d;
    font-size: 18px;
    line-height: 1.15;
    white-space: nowrap;
  }

  .moya-tab-slider__bubble--one {
    top: 4%;
    right: 7%;
  }
  .moya-tab-slider__bubble--two {
    top: 17%;
    left: 20%;
  }
  .moya-tab-slider__bubble--three {
    top: 30%;
    left: 40%;
  }
  .moya-tab-slider__bubble--four {
    top: 52%;
    left: 2%;
  }
  .moya-tab-slider__bubble--five {
    top: 58%;
    right: 15%;
  }
  .moya-tab-slider__bubble--six {
    right: 17%;
    bottom: 10%;
  }

  .moya-tab-slider__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: min(1022px, calc(100% - 48px));
    margin: 18px auto 0;
  }

  .moya-tab-slider__tabs {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 100%;
    padding: 6px;
    overflow-x: auto;
    border-radius: 60px;
    background: rgba(255, 255, 255, 0.6);
    box-shadow: 0 0 4px rgba(55, 88, 77, 0.06);
    backdrop-filter: blur(6px);
    scrollbar-width: none;
  }

  .moya-tab-slider__tabs::-webkit-scrollbar {
    display: none;
  }

  .moya-tab-slider__tab-indicator {
    position: absolute;
    z-index: 0;
    top: 6px;
    left: 0;
    width: var(--moya-tab-indicator-width, 0px);
    height: calc(100% - 12px);
    border-radius: 60px;
    background: #ffffff;
    box-shadow: 0 0 4px rgba(55, 88, 77, 0.12);
    transform: translateX(var(--moya-tab-indicator-x, 0px));
    transition:
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1),
      width 900ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .moya-tab-slider__tab {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    min-width: 126px;
    min-height: 52px;
    padding: 14px 34px;
    border: 0;
    border-radius: 60px;
    background: transparent;
    color: var(--moya-tab-label, #003521);
    font-family: 'Outfit', var(--heading-font-family, sans-serif);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
    cursor: pointer;
  }

  .moya-tab-slider__tab[aria-selected='true'] {
    background: transparent;
  }

  .moya-tab-slider__tab:focus-visible,
  .moya-tab-slider__arrow:focus-visible {
    outline: 2px solid var(--moya-tab-heading, #385950);
    outline-offset: 3px;
  }

  .moya-tab-slider__arrows {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
  }

  .moya-tab-slider__arrow {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    padding: 0;
    border: 1px solid rgba(56, 89, 80, 0.48);
    border-radius: 50%;
    background: transparent;
    color: #385950;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .moya-tab-slider__arrow:hover {
    background: #ffffff;
  }

  .moya-tab-slider__arrow span,
  .moya-tab-slider__arrow svg {
    display: block;
    width: 18px;
    height: 18px;
  }

  .moya-tab-slider[data-dragging] .moya-tab-slider__track {
    cursor: grabbing;
    transition: none;
  }

  @media (max-width: 989px) {
    .moya-tab-slider__card {
      grid-template-columns: minmax(0, 0.9fr) minmax(300px, 1.1fr);
    }
    .moya-tab-slider__heading {
      font-size: clamp(38px, 6vw, 52px);
    }
    .moya-tab-slider__text {
      font-size: 16px;
    }
    .moya-tab-slider__visual {
      width: calc(100% - 16px);
      margin-inline-end: 16px;
    }
  }

  @media (max-width: 749px) {
    .moya-tab-slider {
      --moya-tab-card-width: calc(100vw - 32px);
    }
    .moya-tab-slider__track {
      gap: 16px;
    }
    .moya-tab-slider__card {
      grid-template-columns: 1fr;
      height: auto;
      min-height: 620px;
      padding-block: 48px 28px;
    }
    .moya-tab-slider__content {
      width: auto;
      margin: 0 24px;
    }
    .moya-tab-slider__heading {
      max-width: 320px;
      margin-bottom: 14px;
      font-size: 40px;
    }
    .moya-tab-slider__text {
      max-width: 340px;
    }
    .moya-tab-slider__visual {
      width: calc(100% - 32px);
      height: 290px;
      margin: 12px auto 0;
    }
    .moya-tab-slider__bubble {
      font-size: 13px;
    }
    .moya-tab-slider__controls {
      align-items: flex-start;
      width: calc(100% - 32px);
      margin-top: 16px;
    }
    .moya-tab-slider__tabs {
      flex: 1 1 auto;
      min-width: 0;
    }
    .moya-tab-slider__tab {
      min-width: 96px;
      min-height: 44px;
      padding: 10px 20px;
      font-size: 14px;
    }
    .moya-tab-slider__arrows {
      gap: 8px;
    }
    .moya-tab-slider__arrow {
      width: 44px;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moya-tab-slider__track,
    .moya-tab-slider__slide,
    .moya-tab-slider__tab-indicator,
    .moya-tab-slider__tab,
    .moya-tab-slider__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Moya Tab Slider",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    {
      "type": "range",
      "id": "background_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background opacity",
      "default": 60
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background color",
      "default": "#f0f2f2"
    },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#385950" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#4a5565" },
    { "type": "color", "id": "tab_color", "label": "Tab label color", "default": "#003521" },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Product features"
    },
    { "type": "checkbox", "id": "autoplay", "label": "Enable autoplay", "default": false },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Touch" },
        { "type": "image_picker", "id": "image", "label": "Slide illustration" },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Every hug is unique. MoYa learns yours."
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Gentle, sustained physical contact can help the body slow down, feel safer, and return to calm."
        },
        { "type": "header", "content": "Illustration fallback" },
        {
          "type": "text",
          "id": "bubble_1",
          "label": "Bubble 1",
          "default": "You are more important"
        },
        { "type": "text", "id": "bubble_2", "label": "Bubble 2", "default": "Do you love" },
        { "type": "text", "id": "bubble_3", "label": "Bubble 3", "default": "Time to sleep" },
        { "type": "text", "id": "bubble_4", "label": "Bubble 4", "default": "I worried ..." },
        { "type": "text", "id": "bubble_5", "label": "Bubble 5", "default": "Better not" },
        { "type": "text", "id": "bubble_6", "label": "Bubble 6", "default": "You should stop" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Moya Tab Slider",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
