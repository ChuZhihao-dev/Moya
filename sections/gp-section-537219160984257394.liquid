      <style id="custom-css-gA8Y8dJ6bJ">
          .promocode_section_grid {
    margin-bottom: 46px;
  }

  .promocode_grid {
    margin-bottom: 18px;
    justify-content: space-between;
    display: flex;
  }

  .promocode_grid .offer_text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    background: #FCF4EC;
    border-radius: 0px 10px 10px 0px;
    text-align: center;
    padding: 5px 10px;
  }

  .promocode_grid .offer_text h3 {
    letter-spacing: 0px;
    color: #C25B41;
    text-transform: capitalize;
    font-family: 'Poppins', sans-serif;
    font-size: 28px;
    margin: 0;
    line-height: 1.2;
  }

  .promocode_grid .offer_text p {
    font-size: 13px;
    letter-spacing: 0px;
    color: #C25B41;
    margin: 0;
  }

  .offter_code {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    background: #FCF4EC;
    border-radius: 10px 0px 0px 10px;
    text-align: center;
    padding: 5px 10px;
    position: relative;
  }

  .offter_code:before {
    content: "";
    position: absolute;
    left: 0;
    top: 20%;
    height: calc(100% - 40%);
    border: 1px dashed #DBC5BF;
  }

  .offter_code p.code {
    margin: 0;
    letter-spacing: 0px;
    text-transform: capitalize;
    font-size: 18px;
    color: #696969;
  }

  .offter_code p b {
    color: #101010;
  }

  .offter_code p {
    margin: 0;
    color: #101010;
    font-size: 11px;
    letter-spacing: 0px;
  }

  .code_copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #FCF4EC;
    padding: 13px 20px;
  }

  .code_copy span.button {
    min-width: 163px;
    color: rgb(var(--button-text-color, var(--button-text-primary))) !important;
    border-color: #C25B41;
    cursor: pointer;
    border: 2px solid;
  }

  .code_copy span.button.outline:hover {
    background: #C25B41;
    color: #fff;
    background-color: transparent !important;
    color: rgb(var(--button-outline-color) / var(--button-background-opacity, 1)) !important;
  }

  @media screen and (max-width:1499px) {
    .promocode_grid .offer_text h3 {
      font-size: 24px;
    }

    .promocode_grid .offer_text p {
      font-size: 12px;
    }

    .offter_code p.code {
      font-size: 16px;
    }

    .offter_code p {
      font-size: 10px;
    }
  }

  @media screen and (max-width: 767px) {
    .promocode_section_grid {
      margin-bottom: 20px;
    }

    .promocode_grid .offer_text h3 {
      font-size: 16px;
    }

    .offter_code p.code {
      font-size: 13px;
    }

    .code_copy span.button {
      min-width: 123px;
      font-size: 12px;
    }

    .promocode_grid {
      margin-bottom: 10px;
    }
  }

  @media only screen and (max-width:1200px) {
    .promocode_grid .offer_text h3 {
      font-size: 18px;
    }

    .promocode_grid .offer_text p {
      font-size: 11px;
    }

    .offter_code p.code {
      font-size: 14px;
    }

    .offter_code p {
      font-size: 10px;
    }

    .code_copy {
      padding: 7px 10px;
    }

    .code_copy span.button {
      font-size: 14px;
      height: auto;
      padding: 8px 14.5px;
    }
  }

  @media only screen and (max-width:424px) {
    .promocode_grid {
      flex-wrap: wrap;
    }

    .code_copy,
    .code_copy span.button {
      width: 100%;
    }
  }
      </style>
    
      <script id="custom-js-gA8Y8dJ6bJ">
        try {
          
            function copyPromoCode(anchor) {
              const codeToCopy = anchor.getAttribute('data-code');
              const copyBtn = anchor;
              const tempInput = document.createElement('input');
              tempInput.value = codeToCopy;
              document.body.appendChild(tempInput);
              tempInput.select();
              tempInput.setSelectionRange(0, 99999); // For mobile devices
              try {
                const successful = document.execCommand('copy');
                if (successful) {
                  copyBtn.innerText = 'Copying...';
                  setTimeout(() => {
                    copyBtn.innerText = 'Copied';
                  }, 500);
                }
              } catch (err) {
                console.error('Failed to copy:', err);
              }
              document.body.removeChild(tempInput);
            }

        } catch(err){}
      </script>
    
