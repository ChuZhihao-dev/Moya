{% comment %}
  Moya Innovation Research
  “Innovation & Research” 荣誉/奖项区:眉标 + 大标题 + 副标题 + 一排奖项 Logo 卡片。
  每个 Logo 通过后台 image_picker 上传,可选跳转链接;非交互区块,无需 JS。
{% endcomment %}

{% render 'moya-fonts' %}

<style>
  #Moya-Innovation-Research-{{ section.id }} {
    --moya-ir-bg: {{ section.settings.background_color }};
    --moya-ir-heading: {{ section.settings.heading_color }};
    --moya-ir-body: {{ section.settings.body_color }};
    --moya-ir-eyebrow: {{ section.settings.eyebrow_color }};
    --moya-ir-card-bg: {{ section.settings.card_background }};
  }
  .moya-ir {
    background-color: var(--moya-ir-bg, #f0f2f2);
    padding: 120px var(--moya-page-inset);
    font-family: 'Outfit', var(--text-font-family, sans-serif);
  }
  .moya-ir__inner {
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }
  .moya-ir__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 720px;
    text-align: center;
  }
  .moya-ir__eyebrow {
    margin: 0 0 21px;
    color: var(--moya-ir-eyebrow, #37584d);
    font-family: 'Outfit', var(--text-font-family, sans-serif);
    font-size: 12px;
    font-weight: 700;
    font-style: normal;
    line-height: 100%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .moya-ir__title {
    margin: 0 0 24px;
    color: var(--moya-ir-heading, #003521);
    font-family: 'Outfit', var(--heading-font-family, sans-serif);
    font-size: clamp(38px, 4.44vw, 64px);
    font-weight: 600;
    font-style: normal;
    line-height: 100%;
    letter-spacing: -0.02em;
    text-transform: capitalize;
  }
  .moya-ir__subtitle {
    margin: 0;
    color: var(--moya-ir-body, #4a5565);
    opacity: 0.8;
    font-family: 'Lexend Deca', var(--text-font-family, sans-serif);
    font-size: 18px;
    font-weight: 400;
    font-style: normal;
    line-height: 150%;
    letter-spacing: -0.02em;
  }
  .moya-ir__subtitle p {
    margin: 0;
  }

  .moya-ir__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
  }
  .moya-ir__card {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 136px;
    padding: 20px;
    border-radius: 16px;
    background-color: var(--moya-ir-card-bg, #ffffff);
    text-decoration: none;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  a.moya-ir__card:hover,
  a.moya-ir__card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
  }
  a.moya-ir__card:focus-visible {
    outline: 2px solid var(--moya-ir-heading, #003521);
    outline-offset: 3px;
  }
  .moya-ir__logo {
    display: block;
    width: auto;
    height: auto;
    max-width: 96px;
    max-height: 96px;
    object-fit: contain;
    -webkit-user-drag: none;
    user-select: none;
  }
  .moya-ir__placeholder {
    color: var(--moya-ir-body, #4a5565);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
  }

  @media (max-width: 749px) {
    .moya-ir {
      padding: 64px 20px;
    }
    .moya-ir__inner {
      gap: 32px;
    }
    .moya-ir__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .moya-ir__card {
      height: 104px;
      border-radius: 12px;
    }
    .moya-ir__logo {
      max-width: 72px;
      max-height: 72px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moya-ir__card {
      transition: none;
    }
    a.moya-ir__card:hover {
      transform: none;
    }
  }
</style>

<div id="Moya-Innovation-Research-{{ section.id }}" class="moya-ir">
  <div class="moya-ir__inner">
    <div class="moya-ir__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="moya-ir__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="moya-ir__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="moya-ir__subtitle">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="moya-ir__grid" role="list">
        {%- for block in section.blocks -%}
          {%- assign card_tag = 'div' -%}
          {%- if block.settings.link != blank -%}
            {%- assign card_tag = 'a' -%}
          {%- endif -%}
          <{{ card_tag }}
            class="moya-ir__card"
            role="listitem"
            {% if card_tag == 'a' %}hdata-moya-ref="{{ block.settings.link }}"{% endif %}
            {% if block.settings.logo == blank and block.settings.title != blank %}aria-label="{{ block.settings.title | escape }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.logo != blank -%}
              {%- assign alt_text = block.settings.title | default: 'Award logo' -%}
              {{ block.settings.logo
                 | image_url: width: 400
                 | image_tag: loading: 'lazy', widths: '160,240,320,400', sizes: '(min-width: 750px) 18vw, 42vw', alt: alt_text, class: 'moya-ir__logo' }}
            {%- elsif block.settings.title != blank -%}
              <span class="moya-ir__placeholder">{{ block.settings.title | escape }}</span>
            {%- endif -%}
          </{{ card_tag }}>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Moya Innovation Research",
  "tag": "section",
  "class": "moya-innovation-research",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Recognition"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Innovation & Research"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Years of research and innovation go into every embrace.<br/>Mo'ya is protected by a global portfolio of patents.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f0f2f2"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#37584d"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#003521"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#4a5565"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Logo card background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Award logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Used as the accessible label and shown if no logo is set."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Moya Innovation Research",
      "blocks": [
        { "type": "logo", "settings": { "title": "Red Dot Award" } },
        { "type": "logo", "settings": { "title": "Design Intelligence Award" } },
        { "type": "logo", "settings": { "title": "Beyond Expo" } },
        { "type": "logo", "settings": { "title": "Milano Design Week" } },
        { "type": "logo", "settings": { "title": "iF Design Award" } }
      ]
    }
  ]
}
{% endschema %}
