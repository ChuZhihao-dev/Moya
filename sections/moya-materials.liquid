{{ 'moya-materials.min.css' | asset_url | stylesheet_tag }}
<script type='module' src='{{ 'moya-materials.min.js' | asset_url }}'></script>
<moya-materials
  id='MoyaMaterials-{{ section.id }}'
  class='moya-materials{% if section.settings.image_position == 'right' %} moya-materials--reverse{% endif %}'
  data-motion='{{ section.settings.enable_motion }}'
  data-duration='{{ section.settings.duration }}'
  style='
    --material-background: {{ section.settings.background }};
    --material-ink: {{ section.settings.text_color }};
    --material-active: {{ section.settings.active_color }};
    --material-card: {{ section.settings.card_color }};
    --material-spacing: {{ section.settings.padding_block }}px;
  '
>
  <div class='moya-materials__container'>
    {%- if section.settings.heading != blank -%}
      <h2 class='moya-materials__heading'>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class='moya-materials__layout'>
      <div class='moya-materials__scene' id='MaterialScene-{{ section.id }}'>
        {%- if section.settings.image != blank -%}
          {%- assign hero_alt = section.settings.image.alt | default: section.settings.image_alt -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              class: 'moya-materials__product',
              widths: '360,540,735,1000,1400',
              sizes: '(max-width: 749px) calc(100vw - 40px), (max-width: 1099px) 42vw, 650px',
              loading: 'lazy',
              decoding: 'async',
              alt: hero_alt
          }}
        {%- else -%}
          <div
            class='moya-materials__placeholder'
            role='img'
            aria-label='MoYa product image placeholder'
          >
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>
      <div class='moya-materials__grid' role='group' aria-label='Explore MoYa materials'>
        {%- for block in section.blocks -%}
          <article
            id='MaterialCard-{{ section.id }}-{{ block.id }}'
            class='moya-materials__card{% if forloop.first %} is-active{% endif %}'
            data-material-card
            data-title='{{ block.settings.title | escape }}'
            {{ block.shopify_attributes }}
          >
            <div
              class='moya-materials__thumbnail'
              {% if block.settings.image == blank %}
                aria-hidden='true'
              {% endif %}
            >
              {%- if block.settings.image != blank -%}
                {%- assign detail_alt = block.settings.image.alt | default: block.settings.title -%}
                {{
                  block.settings.image
                  | image_url: width: 672
                  | image_tag:
                    widths: '144,224,336,448,672',
                    sizes: '(max-width: 479px) 96px, (max-width: 749px) 40vw, 224px',
                    loading: 'lazy',
                    decoding: 'async',
                    alt: detail_alt
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'moya-materials__placeholder' }}
              {%- endif -%}
            </div>
            <h3 class='moya-materials__title'>
              <button
                type='button'
                class='moya-materials__select'
                data-material-select
                aria-pressed='{% if forloop.first %}true{% else %}false{% endif %}'
              >
                {{ block.settings.title | escape }}
              </button>
            </h3>
            {%- if block.settings.description != blank -%}
              <div class='moya-materials__description prose'>{{ block.settings.description }}</div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
  <p class='sr-only' data-material-status aria-live='polite' aria-atomic='true'></p>
</moya-materials>
{% schema %}
{
  "name": "Moya materials",
  "tag": "section",
  "class": "shopify-section--moya-materials",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Soft On The Outside. Thoughtful Within."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "MoYa product image",
      "info": "A transparent product image works best. Loaded through Shopify CDN."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Product image description",
      "default": "MoYa with arms open, showing its soft outer fabric"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop product position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left — design layout"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f0f2f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#003521"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Selected card background",
      "default": "#37584d"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical spacing",
      "min": 40,
      "max": 160,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "enable_motion",
      "label": "Enable motion",
      "default": true
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Motion duration",
      "min": 200,
      "max": 1000,
      "step": 20,
      "unit": "ms",
      "default": 640
    }
  ],
  "blocks": [
    {
      "type": "material",
      "name": "Material detail",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Material detail"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Describe this material detail.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Detail image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Moya materials",
      "blocks": [
        {
          "type": "material",
          "settings": {
            "title": "Material For Everyday",
            "description": "<p>Mink-Like Skin-Friendly Fabric<br>Soft Against Skin; Outer Cover Removable And Washable.</p>"
          }
        },
        {
          "type": "material",
          "settings": {
            "title": "Eyes That Meet You Back",
            "description": "<p>Mink-Like Skin-Friendly Fabric<br>Soft Against Skin; Outer Cover Removable And Washable.</p>"
          }
        },
        {
          "type": "material",
          "settings": {
            "title": "Softness With Support",
            "description": "<p>Mink-Like Skin-Friendly Fabric<br>Soft Against Skin; Outer Cover Removable And Washable.</p>"
          }
        },
        {
          "type": "material",
          "settings": {
            "title": "Weight Approx. 4.5 Kg",
            "description": "<p>Stable And Reassuring To Hold And Lean On.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
